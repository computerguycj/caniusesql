<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The chiseled runtime image has no ICU. Nothing here is culture-specific. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings the catalog code and a copy of data.json (see its .csproj). -->
    <ProjectReference Include="..\CanIUseSql.Catalog\CanIUseSql.Catalog.csproj" />
  </ItemGroup>

</Project>
